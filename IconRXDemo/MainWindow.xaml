<Window x:Class="IconRXDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        
        xmlns:icon="clr-namespace:IconRX;assembly=IconRX"

        Title="IconRX Demo"
        Height="240"
        Width="420" Background="Wheat"  d:Visibility="Visible" >

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Stretch">
        <TextBlock Text="Don't forget set icons as Resource and compile. &#x0A;These icons are ready to test:"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   TextWrapping="Wrap"
                   Padding="20,20" LineHeight="20" />

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

            <icon:Icon Source="/Assets/home.svg"
                       Width="24" Height="24"
                       Margin="8"
                       Foreground="#333333" />

            <icon:Icon Source="/Assets/download.svg"
                       Width="48" Height="48"
                       Margin="8"
                       Foreground="#2D7FF9" />

            <icon:Icon Source="/Assets/star.svg"
                       Width="72" Height="72"
                       Margin="8"
                       Foreground="#E5484D" />
        </StackPanel>
        
    </StackPanel>

</Window>
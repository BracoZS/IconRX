<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IconRX</RootNamespace>
    <AssemblyName>IconRX</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>IconRX</PackageId>
    <Version>1.0.0</Version>
    <Authors>Bracozs</Authors>
    <Company>Bracozs</Company>
    <Description>SVG icons for WPF.

Drop an .svg file in your project, point Source="/YourAssets/my-icon.svg" at it, and you get a crisp icon you can color and resize however you want. Simple and easy.</Description>
    <PackageTags>wpf;icons;drop-in;svg;control;geometry</PackageTags>
    <RepositoryUrl>https://github.com/BracoZS/IconRX</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>IconRX</Title>
    <Copyright>BracoZS</Copyright>
    <PackageProjectUrl>https://github.com/BracoZS/IconRX</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>